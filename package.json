{
  "name": "pocket-pitlane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:claims": "playwright test --grep @claim:",
    "test:realtime": "cargo test --manifest-path realtime/Cargo.toml",
    "check": "npm run build && npm test && npm run test:realtime"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
